# Settings for Pinny's deploy, backup and alert scripts (not read by Pinny
# itself). pinny-bootstrap copies this file to /etc/pinny/ops.env (owner
# root, mode 0600) if it does not exist. Fill in the CHANGE_ME values from
# the AWS setup in docs/deployment.md, then run pinny-bootstrap again to
# turn on the backup and alert timers.
#
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# No AWS keys: the scripts use the instance's IAM role.

# AWS region of the bucket and the SNS topic, e.g. us-east-1.
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
# Private, versioned, encrypted S3 bucket for backups (deploy/aws/).
PINNY_BACKUP_BUCKET=CHANGE_ME
# SNS topic that emails alerts, e.g. arn:aws:sns:us-east-1:123456789012:pinny-alerts
PINNY_ALERT_TOPIC_ARN=CHANGE_ME
# Profiles on this machine.
PINNY_PROFILES=production staging
# Where pinny-deploy fetches the code. For a private repository use the
# SSH form (git@github.com:cnealblack8191/agentpinny.git) and a read-only
# deploy key; see docs/deployment.md.
PINNY_GIT_URL=https://github.com/cnealblack8191/agentpinny.git
