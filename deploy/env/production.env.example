# Pinny production settings. pinny-bootstrap copies this file to
# /etc/pinny/production.env (owner root, mode 0600) if it does not exist.
# Edit it there, then: sudo systemctl restart pinny@production.target
#
# Format: KEY=value, one per line, no quotes, no spaces around "=".
# No passwords or keys belong here: sign-in data lives in site.sqlite3.
# PINNY_VERSION is not set here; pinny-deploy writes it per release.

PINNY_ENV=production
PINNY_DATA_DIR=/srv/pinny/production
PINNY_ORIGIN=https://pinny.ecinc.us
# Who is admin on first start (comma-separated). Change this to your email.
PINNY_ADMIN_EMAILS=CHANGE_ME@ecinc.us
# PDFs are opened only by the separate worker services.
PINNY_JOBS=external
# Port on 127.0.0.1 that Caddy forwards pinny.ecinc.us to (deploy/caddy/Caddyfile).
PINNY_PORT=8001
