# Pinny staging settings. pinny-bootstrap copies this file to
# /etc/pinny/staging.env (owner root, mode 0600) if it does not exist.
# Edit it there, then: sudo systemctl restart pinny@staging.target
#
# Staging runs in production mode too (sign-in, sandboxed jobs), with its
# own data, members and port. Never copy production data into it.
#
# Format: KEY=value, one per line, no quotes, no spaces around "=".

PINNY_ENV=production
PINNY_DATA_DIR=/srv/pinny/staging
PINNY_ORIGIN=https://staging.pinny.ecinc.us
PINNY_ADMIN_EMAILS=CHANGE_ME@ecinc.us
PINNY_JOBS=external
PINNY_PORT=8002
