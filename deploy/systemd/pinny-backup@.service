# Nightly backup of one profile's data directory to S3 (pinny-backup@<profile>.timer).
# SQLite databases are copied with SQLite's online backup API, then the
# archive and its sha256 manifest go to s3://$PINNY_BACKUP_BUCKET/pinny/%i/.
# Credentials come from the instance's IAM role; nothing is stored on disk.
[Unit]
Description=Pinny backup (%i)
After=network-online.target
Wants=network-online.target
OnFailure=pinny-alert@%n.service

[Service]
Type=oneshot
User=pinny-%i
Group=pinny-%i
SupplementaryGroups=pinny-%i-jobs
EnvironmentFile=/etc/pinny/%i.env
EnvironmentFile=/etc/pinny/ops.env
# /var/lib/pinny-backup/%i: status.json (read by pinny-check-alerts), work/ (temporary archive).
StateDirectory=pinny-backup/%i
StateDirectoryMode=0755
Environment=HOME=/var/lib/pinny-backup/%i
ExecStart=/usr/local/sbin/pinny-backup --profile %i
Nice=10
IOSchedulingClass=idle
UMask=0077
MemoryMax=1G
TimeoutStartSec=3h

NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
# Read-write only because SQLite may touch the -shm/-wal files while reading.
ReadWritePaths=/srv/pinny/%i
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
