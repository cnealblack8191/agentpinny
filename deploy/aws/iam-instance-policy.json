{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListPinnyBackups",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME",
      "Condition": {
        "StringLike": {
          "s3:prefix": ["pinny/*"]
        }
      }
    },
    {
      "Sid": "WriteAndReadPinnyBackups",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME/pinny/*"
    },
    {
      "Sid": "SendPinnyAlerts",
      "Effect": "Allow",
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:us-east-1:ACCOUNT_ID:pinny-alerts"
    }
  ]
}
