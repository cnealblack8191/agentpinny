# Pinny: HTTPS and reverse proxy for production and staging (docs/deployment.md).
# Installed as /etc/caddy/Caddyfile by pinny-bootstrap.
#
# Caddy gets and renews Let's Encrypt certificates on its own (ports 80 and
# 443 must be open and the DNS names must point at this instance), sends
# plain HTTP to HTTPS, and forwards to Pinny on 127.0.0.1. It passes the
# client address and scheme in X-Forwarded-For and X-Forwarded-Proto, and
# replaces any X-Forwarded-* a client sent. Pinny trusts those headers only
# from 127.0.0.1.
#
# Security headers (CSP, HSTS, frame, referrer, nosniff) come from Pinny
# itself, on every response, so Caddy adds none.
{
	servers {
		# Only TCP 443 is open in the security group, so no HTTP/3 (UDP).
		protocols h1 h2
		timeouts {
			# Slow clients cannot hold connections open forever.
			read_header 15s
			# Uploads (up to 200 MB) must arrive within 5 minutes.
			read_body 5m
			idle 2m
		}
	}
}

# Arguments: profile name, Pinny port.
(pinny_site) {
	log {
		output file /var/log/caddy/pinny-{args[0]}.log {
			roll_size 50MiB
			roll_keep 10
			roll_keep_for 720h
			# Group caddy may read it (pinny-check-alerts counts 5xx responses).
			mode 0640
		}
		format json
	}

	header -Server

	# PDF uploads: POST /api/documents, up to Pinny's 200 MB limit.
	@upload {
		method POST
		path /api/documents
	}
	handle @upload {
		request_body {
			max_size 200MiB
		}
		reverse_proxy 127.0.0.1:{args[1]} {
			transport http {
				dial_timeout 5s
				response_header_timeout 5m
			}
		}
	}

	# Everything else: JSON bodies up to 1 MB.
	handle {
		request_body {
			max_size 1MiB
		}
		reverse_proxy 127.0.0.1:{args[1]} {
			transport http {
				dial_timeout 5s
				# A scan waits for its job (up to 6 minutes, plus queueing).
				response_header_timeout 15m
			}
		}
	}
}

pinny.ecinc.us {
	import pinny_site production 8001
}

staging.pinny.ecinc.us {
	import pinny_site staging 8002
}
